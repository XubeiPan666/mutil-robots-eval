# Optional shell configuration. The launcher does not automatically read .env.
# Copy to .env, edit, then: set -a; source .env; set +a
VLA_SERVER_URL=http://127.0.0.1:20011

# Independent single-arm servers (used with --mode per-arm).
ARM0_VLA_SERVER_URL=http://127.0.0.1:20011
ARM1_VLA_SERVER_URL=http://127.0.0.1:20012
PERARM_PROXY_HOST=127.0.0.1
PERARM_PROXY_PORT=31888

# Optional VLM planning experiments only; rule-based evaluation needs no API key.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
